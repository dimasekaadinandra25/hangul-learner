{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hangul Learner",
  "version": "1.5.1",
  "identifier": "com.hangul.learner",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hangul Learner",
        "width": 1000,
        "height": 780,
        "minWidth": 360,
        "minHeight": 500,
        "visible": false
      },
      {
        "label": "mini",
        "title": "Hangul Learner mini player",
        "url": "mini.html",
        "width": 340,
        "height": 268,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEMzJFRTU4NDIzQjgzMEIKUldRTGd6dENXTzR5N2V3M1N5M2ljWk41aHliaXE2OW50aFVBN1ZCdzdWNWpZMUo3NmVDV0NJdUwK",
      "endpoints": ["https://github.com/dimasekaadinandra25/hangul-learner/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Hangul Learner",
    "shortDescription": "Learn Hangul and TOPIK Korean",
    "longDescription": "Read, write and listen to Korean: Hangul letters and TOPIK 1-6 vocabulary with saved progress.",
    "category": "Education",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}